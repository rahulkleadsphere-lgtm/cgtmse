# CGTMSE Assist Backend Configuration Template
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
DEBUG=False

# Groq LLM Settings
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=750

# Qdrant Vector Database Settings
QDRANT_URL=https://your-cluster-id.us-west-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=cgtmse_knowledge_base
QDRANT_TIMEOUT=30

# Embedding Settings (builtin / huggingface / openai)
EMBEDDING_PROVIDER=builtin
EMBEDDING_DIMENSION=384
HF_TOKEN=
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_URL=https://api.openai.com/v1

# Security & CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://cgtmse-69w5.vercel.app,*
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_SIZE_MB=25
API_SECRET_KEY=
